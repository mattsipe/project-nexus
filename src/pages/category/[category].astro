---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Library from '../../components/react/Library.tsx';
import { libraryDocs, CATEGORY_LABELS } from '../../lib/games.ts';
import { CATEGORIES } from '../../content.config.ts';

export const getStaticPaths = (async () => {
  return CATEGORIES.map((category) => ({ params: { category } }));
}) satisfies GetStaticPaths;

const { category } = Astro.params;
const label = CATEGORY_LABELS[category as (typeof CATEGORIES)[number]];
const docs = await libraryDocs();
---

<BaseLayout title={label} description={`Every ${label.toLowerCase()} game on Project Nexus.`}>
  <Library client:load docs={docs} initialCategory={category as (typeof CATEGORIES)[number]} />
</BaseLayout>
