---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import GameGrid from '../../components/GameGrid.astro';
import { gamesByCategory, CATEGORY_LABELS } from '../../lib/games.ts';

export const getStaticPaths = (async () => {
  const groups = await gamesByCategory();
  return groups.map(({ category, games }) => ({
    params: { category },
    props: { category, games },
  }));
}) satisfies GetStaticPaths;

const { category, games } = Astro.props;
const label = CATEGORY_LABELS[category];
---

<BaseLayout title={label} description={`Every ${label.toLowerCase()} game on Project Nexus.`}>
  <section class="shell pt-12 pb-2">
    <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">{label}</h1>
    <p class="mt-3 text-text-dim">
      <span class="tnum">{games.length}</span>
      {games.length === 1 ? 'game' : 'games'}
    </p>
  </section>
  <section class="shell mt-8">
    <GameGrid games={games} />
  </section>
</BaseLayout>
