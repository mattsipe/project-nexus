---
import BaseLayout from '../layouts/BaseLayout.astro';
import FavoritesList from '../components/react/FavoritesList.tsx';
import { searchIndex } from '../lib/games.ts';

const docs = await searchIndex();
---

<BaseLayout title="Favourites" description="The games you have starred on this device.">
  <section class="shell pt-12">
    <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Favourites</h1>
    <p class="mt-3 max-w-prose text-text-dim">
      Stored on this device only. Clearing your browser data clears this list.
    </p>
  </section>
  <FavoritesList client:load docs={docs} />
</BaseLayout>
