---
import BaseLayout from '../layouts/BaseLayout.astro';
import Library from '../components/react/Library.tsx';
import { libraryDocs } from '../lib/games.ts';

const docs = await libraryDocs();
---

<BaseLayout title="Favourites" description="The games you have starred on this device.">
  <Library client:load docs={docs} initialFavoritesOnly />
</BaseLayout>
