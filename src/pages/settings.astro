---
import BaseLayout from '../layouts/BaseLayout.astro';
import SaveManager from '../components/react/SaveManager.tsx';
---

<BaseLayout title="Settings" description="Back up your saves and manage what Project Nexus stores.">
  <section class="shell pt-12">
    <div class="mb-3 flex items-center gap-2 text-text-faint">
      <img src="/brand/mark-52.png" srcset="/brand/mark-52.png 2x, /brand/mark-78.png 3x" width="20" height="20" alt="" />
      <span class="font-display text-[11px] font-bold tracking-[0.18em] uppercase">Project Nexus</span>
    </div>
    <h1 class="font-display text-4xl font-extrabold tracking-tight sm:text-5xl">Settings</h1>
    <p class="mt-4 max-w-prose leading-relaxed text-text-dim">
      Project Nexus has no accounts and no server. Everything below lives in this browser, on this
      device. If you clear your browsing data, it goes with it — so if you have sunk real time
      into an incremental, take a backup.
    </p>
  </section>
  <SaveManager client:load />
</BaseLayout>
