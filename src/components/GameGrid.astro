---
import type { Game } from '../lib/games.ts';
import GameCard from './GameCard.astro';

interface Props {
  games: Game[];
  priorityCount?: number;
}

const { games, priorityCount = 4 } = Astro.props;
---

<div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
  {games.map((game, i) => <GameCard game={game} priority={i < priorityCount} />)}
</div>
